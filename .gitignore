# Transient staging directories created by trio-figure replays.
candidate-outputs/figures-source/**/replay-staging-*/

# Local PDF-render previews used while reviewing candidate figure layouts.
candidate-outputs/figures-source/tmp/

# Generated thesis compile artifact. Source remains in overleaf/.
overleaf/main.pdf
overleaf/thesis.pdf

# Local reference binaries. Keep these in the workspace, but do not track them
# by default because they are heavy and may not be suitable for public hosting.
literature/**/*.pdf
supporting-material/**/*.docx

# Hadar reference thesis: optional local clone, not tracked by this repository.
literature/thesis-examples/Hadar's Thesis/

# Legacy Google Drive artifact left after moving internal files.
Internal resources/
