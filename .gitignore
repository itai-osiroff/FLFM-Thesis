# Local export/build locations
build/
dist/
exports/
$tmp/
work/

# Generated thesis compile artifact. Source remains in overleaf/.
overleaf/main.pdf
overleaf/thesis.pdf

# Local reference binaries. Keep these in the workspace, but do not track them
# by default because they are heavy and may not be suitable for public hosting.
literature/**/*.pdf
supporting-material/**/*.docx

# Hadar reference thesis: retain PDF figure assets, not generated thesis output.
!literature/thesis-examples/
!literature/thesis-examples/Hadar's Thesis/
!literature/thesis-examples/Hadar's Thesis/figs/
!literature/thesis-examples/Hadar's Thesis/figs/**/*.pdf
literature/thesis-examples/Hadar's Thesis/Main.pdf
literature/thesis-examples/Hadar's Thesis/*.aux
literature/thesis-examples/Hadar's Thesis/*.bbl
literature/thesis-examples/Hadar's Thesis/*.blg
literature/thesis-examples/Hadar's Thesis/*.log
